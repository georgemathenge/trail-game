generator client {
  provider = "prisma-client-js"
  moduleFormat  = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model check_ins {
  id                              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  registration_id                 String        @db.Uuid
  checkpoint_id                   String        @db.Uuid
  checked_in_at                   DateTime?     @default(now()) @db.Timestamp(6)
  latitude                        Decimal?      @db.Decimal(10, 8)
  longitude                       Decimal?      @db.Decimal(11, 8)
  gps_accuracy_meters             Decimal?      @db.Decimal(10, 2)
  distance_from_checkpoint_meters Decimal?      @db.Decimal(10, 2)
  photo_url                       String?
  photo_verified                  Boolean?      @default(false)
  manually_verified               Boolean?      @default(false)
  verified_by                     String?       @db.Uuid
  points_earned                   Int?          @default(0)
  time_bonus_earned               Int?          @default(0)
  is_valid                        Boolean?      @default(true)
  invalid_reason                  String?
  created_at                      DateTime?     @default(now()) @db.Timestamp(6)
  updated_at                      DateTime?     @default(now()) @db.Timestamp(6)
  checkpoints                     checkpoints   @relation(fields: [checkpoint_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrations                   registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                           users?        @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([registration_id, checkpoint_id])
  @@index([checked_in_at], map: "idx_checkins_checked_in_at")
  @@index([checkpoint_id], map: "idx_checkins_checkpoint_id")
  @@index([registration_id], map: "idx_checkins_registration_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model checkpoints {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  game_id              String        @db.Uuid
  trail_id             String?       @db.Uuid
  checkpoint_number    Int
  name                 String?       @db.VarChar(255)
  description          String?
  custom_location_name String?       @db.VarChar(255)
  latitude             Decimal?      @db.Decimal(10, 8)
  longitude            Decimal?      @db.Decimal(11, 8)
  address              String?
  floor_level          String?       @db.VarChar(50)
  checkpoint_type      String        @db.VarChar(50)
  content              Json?
  points               Int?          @default(0)
  time_bonus_seconds   Int?
  requires_photo       Boolean?      @default(false)
  requires_gps         Boolean?      @default(true)
  gps_radius_meters    Int?          @default(50)
  is_optional          Boolean?      @default(false)
  next_checkpoint_id   String?       @db.Uuid
  is_active            Boolean?      @default(true)
  created_at           DateTime?     @default(now()) @db.Timestamp(6)
  updated_at           DateTime?     @default(now()) @db.Timestamp(6)
  check_ins            check_ins[]
  games                games         @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  checkpoints          checkpoints?  @relation("checkpointsTocheckpoints", fields: [next_checkpoint_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_checkpoints    checkpoints[] @relation("checkpointsTocheckpoints")
  trails               trails?       @relation(fields: [trail_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([game_id, checkpoint_number])
  @@index([checkpoint_number], map: "idx_checkpoints_checkpoint_number")
  @@index([game_id], map: "idx_checkpoints_game_id")
  @@index([trail_id], map: "idx_checkpoints_trail_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model games {
  id                                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  creator_id                        String          @db.Uuid
  location_id                       String?         @db.Uuid
  title                             String          @db.VarChar(255)
  description                       String?
  game_type                         String          @db.VarChar(50)
  template_id                       String?         @db.VarChar(50)
  game_environment                  String?         @default("outdoor") @db.VarChar(20)
  scheduled_date                    DateTime        @db.Date
  scheduled_time                    DateTime        @db.Time(6)
  duration_minutes                  Int
  registration_deadline             DateTime?       @db.Timestamp(6)
  max_participants                  Int
  min_participants                  Int?            @default(1)
  current_participants              Int?            @default(0)
  is_team_based                     Boolean?        @default(false)
  team_size                         Int?
  max_teams                         Int?
  entry_fee                         Decimal?        @default(0.00) @db.Decimal(10, 2)
  currency                          String?         @default("KES") @db.VarChar(3)
  is_free                           Boolean?        @default(true)
  game_config                       Json?
  rules                             String?
  status                            String?         @default("draft") @db.VarChar(20)
  is_featured                       Boolean?        @default(false)
  is_private                        Boolean?        @default(false)
  cancellation_policy               String?
  can_cancel_until                  DateTime?       @db.Timestamp(6)
  winner_team_id                    String?         @db.Uuid
  winner_user_id                    String?         @db.Uuid
  total_views                       Int?            @default(0)
  total_registrations               Int?            @default(0)
  completion_rate                   Decimal?        @db.Decimal(5, 2)
  average_rating                    Decimal?        @default(0.00) @db.Decimal(3, 2)
  total_ratings                     Int?            @default(0)
  created_at                        DateTime?       @default(now()) @db.Timestamp(6)
  updated_at                        DateTime?       @default(now()) @db.Timestamp(6)
  started_at                        DateTime?       @db.Timestamp(6)
  completed_at                      DateTime?       @db.Timestamp(6)
  cancelled_at                      DateTime?       @db.Timestamp(6)
  deleted_at                        DateTime?       @db.Timestamp(6)
  checkpoints                       checkpoints[]
  users_games_creator_idTousers     users           @relation("games_creator_idTousers", fields: [creator_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations                         locations?      @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_games_winner_user_idTousers users?          @relation("games_winner_user_idTousers", fields: [winner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrations                     registrations[]
  reviews                           reviews[]
  teams                             teams[]

  @@index([created_at], map: "idx_games_created_at")
  @@index([creator_id], map: "idx_games_creator_id")
  @@index([game_type], map: "idx_games_game_type")
  @@index([is_featured], map: "idx_games_is_featured")
  @@index([location_id], map: "idx_games_location_id")
  @@index([scheduled_date], map: "idx_games_scheduled_date")
  @@index([status], map: "idx_games_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model locations {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String    @db.VarChar(255)
  description      String?
  address          String?
  city             String?   @db.VarChar(100)
  country          String?   @default("Kenya") @db.VarChar(100)
  latitude         Decimal   @db.Decimal(10, 8)
  longitude        Decimal   @db.Decimal(11, 8)
  difficulty_level String?   @db.VarChar(20)
  total_area_km    Decimal?  @db.Decimal(10, 2)
  elevation_min    Int?
  elevation_max    Int?
  cover_image_url  String?
  images_urls      String[]
  has_parking      Boolean?  @default(false)
  has_restrooms    Boolean?  @default(false)
  has_water        Boolean?  @default(false)
  entry_fee        Decimal?  @default(0.00) @db.Decimal(10, 2)
  opening_time     DateTime? @db.Time(6)
  closing_time     DateTime? @db.Time(6)
  is_open_24_7     Boolean?  @default(false)
  is_active        Boolean?  @default(true)
  is_verified      Boolean?  @default(false)
  created_by       String?   @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  deleted_at       DateTime? @db.Timestamp(6)
  games            games[]
  users            users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trails           trails[]

  @@index([city], map: "idx_locations_city")
  @@index([latitude, longitude], map: "idx_locations_coordinates")
  @@index([created_by], map: "idx_locations_created_by")
  @@index([is_active], map: "idx_locations_is_active")
}

model notifications {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String    @db.Uuid
  type                String    @db.VarChar(50)
  title               String    @db.VarChar(255)
